# NewsAPI — obtenha sua chave em https://newsapi.org/register
NEWS_API_KEY=your_newsapi_key_here

# Google GenAI (Gemini) — obtenha sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Banco de dados PostgreSQL (Neon) — gerado pelo SST em produção
# Para desenvolvimento local, crie um banco em https://console.neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
