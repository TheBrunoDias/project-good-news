{
  "name": "daily-good-news",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "deploy:dev": "sst deploy --stage dev"
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "sst": "^4",
    "turbo": "^2",
    "typescript": "^6"
  }
}
